# Copy to .env (never commit .env), or just run: python manyreply.py setup
#
# Zernio posts to Instagram and sends the DMs: https://zernio.com (dashboard > API keys)
ZERNIO_API_KEY=
#
# The AI that writes your posts. Bring your own account. Pick ONE provider and set its key:
#   LLM_PROVIDER is one of: anthropic, openai, gemini, openrouter, ollama, openai-compatible
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY=
#
# The model. A default exists for anthropic, openai and gemini and can go out of date: if the provider says the
# model is unknown, set this to a current name from its docs. openrouter, ollama and openai-compatible need it.
# LLM_MODEL=
# ollama (default http://localhost:11434) and openai-compatible servers (for example https://host/v1):
# LLM_BASE_URL=
#
# Optional. Only used to address the printed "post is live" report.
# NOTIFY_EMAIL=you@example.com
# Optional. Without it the script uses `gh auth token`, or GitHub's slower anonymous search.
# GITHUB_TOKEN=
# Optional. Only if Chrome/Edge is not in a standard location.
# BROWSER=
# Optional. true = the daily run posts by itself. Leave it off while you are checking the drafts.
# MANYREPLY_AUTO_PUBLISH=true
# Optional. A Telegram bot (create one with @BotFather) you send GitHub links to; they are posted first.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
